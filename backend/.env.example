# Main application database
DATABASE_URL="mysql://YOUR_USERNAME:YOUR_PASSWORD@localhost:3307/teampulse_db"

# Prisma development-only shadow database
SHADOW_DATABASE_URL="mysql://YOUR_USERNAME:YOUR_PASSWORD@localhost:3307/teampulse_shadow_db"

# Backend server
PORT=5000

# Allowed frontend address
FRONTEND_URL=http://localhost:5173

# Replace with a long random value
JWT_SECRET=replace_with_a_long_secure_random_secret

NODE_ENV=development