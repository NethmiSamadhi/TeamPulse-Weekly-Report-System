generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  TEAM_MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ReviewAction {
  REQUEST_CHANGES
  APPROVED
}

enum TimeCategory {
  DEVELOPMENT
  TESTING
  MEETINGS
  DOCUMENTATION
  RESEARCH
  DESIGN
  OTHER
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEAM_MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports            WeeklyReport[]
  reviews            ReportReview[]  @relation("ManagerReviews")
  projectMemberships ProjectMember[]
  activities         ActivityLog[]

  @@index([role])
  @@index([isActive])
}

model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  color       String?  @default("#6366F1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports WeeklyReport[]
  members ProjectMember[]

  @@index([isActive])
}

model ProjectMember {
  userId     String
  projectId  String
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model WeeklyReport {
  id                    String       @id @default(cuid())
  userId                String
  projectId             String?
  weekStart             DateTime     @db.Date
  weekEnd               DateTime     @db.Date
  dueDate               DateTime?
  status                ReportStatus @default(DRAFT)
  currentVersionNumber  Int          @default(1)
  latestReviewerComment String?      @db.Text
  submittedAt           DateTime?
  approvedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions ReportVersion[]

  @@unique([userId, weekStart])
  @@index([status])
  @@index([weekStart])
  @@index([projectId])
  @@index([userId, status])
}

model ReportVersion {
  id            String    @id @default(cuid())
  reportId      String
  versionNumber Int
  optionalNotes String?   @db.Text
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?

  report         WeeklyReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  completedTasks CompletedTask[]
  nextWeekTasks  NextWeekTask[]
  blockers       Blocker[]
  achievements   Achievement[]
  timeEntries    TimeEntry[]
  reviews        ReportReview[]

  @@unique([reportId, versionNumber])
  @@index([reportId])
}

model CompletedTask {
  id                String       @id @default(cuid())
  reportVersionId   String
  taskName          String
  priority          TaskPriority @default(MEDIUM)
  plannedPercentage Decimal      @db.Decimal(5, 2)
  actualPercentage  Decimal      @db.Decimal(5, 2)
  status            TaskStatus
  plannedMinutes    Int
  spentMinutes      Int
  deliverable       String?      @db.Text
  displayOrder      Int          @default(0)

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

model NextWeekTask {
  id              String       @id @default(cuid())
  reportVersionId String
  taskName        String
  priority        TaskPriority @default(MEDIUM)
  notes           String?      @db.Text
  displayOrder    Int          @default(0)

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

model Blocker {
  id              String  @id @default(cuid())
  reportVersionId String
  description     String  @db.Text
  isKeyIssue      Boolean @default(false)
  isResolved      Boolean @default(false)
  displayOrder    Int     @default(0)

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
  @@index([isResolved])
}

model Achievement {
  id               String  @id @default(cuid())
  reportVersionId  String
  description      String  @db.Text
  isKeyAchievement Boolean @default(false)
  displayOrder     Int     @default(0)

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
}

model TimeEntry {
  id              String       @id @default(cuid())
  reportVersionId String
  category        TimeCategory
  minutes         Int

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@unique([reportVersionId, category])
}

model ReportReview {
  id              String       @id @default(cuid())
  reportVersionId String
  managerId       String
  action          ReviewAction
  comment         String?      @db.Text
  createdAt       DateTime     @default(now())

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  manager       User          @relation("ManagerReviews", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([reportVersionId])
  @@index([managerId])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}
